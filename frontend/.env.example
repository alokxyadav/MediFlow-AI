# Copy this file to .env (local dev) or .env.production (production build)
# and adjust as needed. Vite only exposes variables prefixed with VITE_.

# Base URL of the MediFlow backend API (include the trailing /api).
# Local dev (docker-compose or `uvicorn main:app`):
VITE_API_BASE_URL=http://localhost:8000/api

# Production example (Railway/Render backend):
# VITE_API_BASE_URL=https://your-backend-domain.example.com/api
