# Copy this file to backend/.env for local development.
# In Docker/Railway/Render, set these as real environment variables instead -
# never commit a real .env file.
#
# IMPORTANT: when ENV=production, the app validates its own configuration
# at startup and REFUSES TO BOOT if JWT_SECRET_KEY / ADMIN_PASSWORD are
# still placeholders, CORS_ORIGINS contains "*", or DATABASE_URL is
# SQLite. See config.py:validate_production_safety(). This is
# intentional - a loud crash at deploy time beats a silent, subtly
# broken production instance.

# --- General ---
ENV=development
DEBUG=true
LOG_LEVEL=INFO
LOG_JSON=false

# --- Database ---
# Local dev default (SQLite file, zero setup):
DATABASE_URL=sqlite:///./mediflow.db
# Production (Postgres, e.g. via docker-compose or a managed DB):
# DATABASE_URL=postgresql://mediflow:mediflow@db:5432/mediflow
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
# How long (seconds) to retry connecting to the DB at startup before
# giving up - handles the DB container/service still coming up.
DB_STARTUP_RETRY_SECONDS=30

# --- Auth ---
# Generate a real one for production: `python -c "import secrets; print(secrets.token_urlsafe(48))"`
JWT_SECRET_KEY=change-this-to-a-long-random-value-in-production
JWT_EXPIRE_MINUTES=720

# First admin account, auto-created on first startup if none exists.
ADMIN_EMAIL=admin@mediflow.ai
ADMIN_PASSWORD=ChangeMe123!

# Minimum length enforced on all staff/admin passwords (also requires
# at least one letter and one digit - see auth.py:validate_password_strength)
MIN_PASSWORD_LENGTH=8

# --- CORS (comma-separated origins allowed to call this API) ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# --- Host header validation (comma-separated, "*" disables the check) ---
# Tighten this in production, e.g. ALLOWED_HOSTS=api.yourhospital.com
ALLOWED_HOSTS=*

# --- Optional: Google Gemini for AI symptom classification ---
# If unset, the API automatically falls back to a local rule-based
# classifier - no functionality is lost, just less nuanced triage.
GEMINI_API_KEY=

# --- Rate limiting ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=60/minute
RATE_LIMIT_CLASSIFY=20/minute
RATE_LIMIT_BOOKING=10/minute

# --- Observability ---
# Prometheus-compatible metrics at GET /metrics (request count + latency).
METRICS_ENABLED=true
# Optional: error tracking. Leave blank to skip - sentry-sdk is an
# optional dependency (see requirements.txt) and is only imported if
# this is set.
SENTRY_DSN=

# --- Request limits ---
# Reject request bodies larger than this (bytes) before reading them.
MAX_REQUEST_BODY_BYTES=1000000
